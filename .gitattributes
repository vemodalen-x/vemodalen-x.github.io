# Markdown uses two trailing spaces as an intentional hard line break.
*.md text eol=lf whitespace=-trailing-space

# Imported WebVTT captions preserve source spacing and cue separation.
*.vtt -whitespace

# Binary portfolio assets should never be line-normalized or text-diffed.
*.docx binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.xlsx binary

# Keep public web sources and deterministic manifests stable across platforms.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.svg text eol=lf
